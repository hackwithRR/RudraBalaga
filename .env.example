# ═══════════════════════════════════════════════════════════════════════
# Rudra Balaga — Environment Variables
# ═══════════════════════════════════════════════════════════════════════

# ── WhatsApp Reverse Verification ─────────────────────────────────────
# The WhatsApp Business number users send the VERIFY token to (no + prefix).
WHATSAPP_PHONE_NUMBER=919019897682

# Custom secret token for Meta webhook handshake verification.
# Must match the value entered in Meta Developer Portal > Webhook setup.
META_VERIFY_TOKEN=YOUR_CUSTOM_SECRET_VERIFY_TOKEN

# Secret used to sign JWT auth tokens for WhatsApp-verified users.
# CHANGE THIS to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret-string

# ── Firebase ──────────────────────────────────────────────────────────
# Full JSON service account key (single-line) for firebase-admin.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── Distance Calculation ─────────────────────────────────────────────
# Google Maps API key for road distance (Distance Matrix API).
# Without this, the app falls back to straight-line (Haversine) distance.
# GOOGLE_MAPS_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated allowed origins, or * for all.
ALLOWED_ORIGINS=*

# ── SMS (OTP fallback) ────────────────────────────────────────────────
# SMS_API_URL=
# SMS_API_KEY=

# ── Truecaller ────────────────────────────────────────────────────────
# TRUECALLER_CLIENT_ID=
# TRUECALLER_PARTNER_KEY=
